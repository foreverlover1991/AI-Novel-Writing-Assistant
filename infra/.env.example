# 前后端分离部署变量模板：复制为同目录 .env 后再修改。
#   cp infra/.env.example infra/.env
# docker-compose 在 infra/ 目录内执行时会自动读取该 .env（已被 .gitignore 忽略，不会误提交密钥）。

# ---------- 复用本机已有镜像（留空即用默认值） ----------
# 默认值已按本机 arm64 已有镜像命名；需要换成私有仓库地址时改这里，不要改编排文件。
POSTGRES_IMAGE=postgres:16.15
QDRANT_IMAGE=qdrant/qdrant:v1.19
WEB_IMAGE=nginx:1.30.2
API_IMAGE=ai-novel-api:latest

# ---------- 必填密钥 ----------
# PostgreSQL 密码，同时用于后端连接串。
POSTGRES_PASSWORD=change-me-postgres
# 访问令牌：所有 /api 请求都要带 Authorization: Bearer <token>，浏览器首次打开时输入。
AI_NOVEL_ACCESS_TOKEN=change-me-32-bytes-random

# ---------- 数据库 ----------
POSTGRES_DB=ai_novel
POSTGRES_USER=ai_novel

# ---------- 对外访问 ----------
# 唯一对外端口。
WEB_PORT=8080
# 只允许本机访问时改成 127.0.0.1。
WEB_BIND_ADDR=0.0.0.0
# 反代后的实际访问地址，用于后端 CORS 与回调链接拼接。
CORS_ORIGIN=http://localhost:8080

# ---------- 挂载路径 ----------
# 宿主机前端产物目录（相对 infra/ 解析），由 pnpm --filter @ai-novel/client build 生成。
CLIENT_DIST_PATH=../client/dist
# 宿主机脚本目录，migrate 一次性任务用它执行 PostgreSQL 基线迁移。
SCRIPTS_PATH=../scripts

# ---------- 功能开关 ----------
# 导演 V1/V2 选择入口。
DIRECTOR_NEXT_ENABLED=true
# 知识库向量检索；改为 false 可先跑通创作主链。
RAG_ENABLED=true
QDRANT_COLLECTION=ai_novel_chunks_v1
# 公网暴露建议收窄请求体上限。
API_JSON_LIMIT=5mb
# 每本小说保留的自动版本快照数量。
NOVEL_SNAPSHOT_RETENTION_COUNT=10
